// libcacao_client — CacaoClient 完整實作（含 A14 相容性修正）
// 32-bit 與 64-bit: 從 C++ 源碼編譯（100% 參照原始 .so 邏輯）
// 反編譯來源: tools_Libcacao/refs/so_32/libcacao_client.so (ARM 32-bit)
//             tools_Libcacao/refs/so_64/libcacao_client.so (ARM 64-bit)
// ─── 32-bit 和 64-bit：從 C++ 源碼編譯 ────────────────────

cc_library_headers {
    name: "libcacao_client_headers",

    defaults: ["libcacao_common_defaults"],

    export_include_dirs: ["include"],
}

cc_library_shared {
    name: "libcacao_client",
    stem: "libcacao_client",

    defaults: ["libcacao_common_defaults"],

    // System (default): cacaoserver and its whole libcacao_* chain are
    // system-side again (see libcacao_service/Android.bp), so this no
    // longer needs to be dual-available -- everything that links it
    // (libimageprocessorjni, libcacao_service, libcacao_process_ctrl_gateway)
    // is on the same partition now.
    compile_multilib: "both",
    vendor_available: true,

    srcs: [
        "src/Cacao.cpp",
        "src/CacaoAidlClient.cpp",
        "src/SharedBuffer_ObjectBase.cpp",
        "src/ImageBuf.cpp",
        "src/ProcessFactory.cpp",
    ],

    header_libs: [
        "libcacao_client_headers",
        "libcacao_service_headers",
        "libcacao_process_ctrl_gateway_headers",
    ],

    shared_libs: [
        "libbinder",
        "libbinder_ndk",
        "libnativewindow",
        "libgui",
        "android.hardware.common-V2-ndk",
        "libcutils",
        "libutils",
        "liblog",
        "libhardware",
        "libhidlbase",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.allocator@2.0",
        "android.hardware.graphics.common@1.0",
        "android.hidl.base@1.0",
        "android.hidl.manager@1.0",
        "libcacao_pal",
    ],

    static_libs: [
        "vendor.somc.cacao-V1-ndk",
        "libaidlcommonsupport",
    ],

    cflags: [
        "-Os",
        "-Wno-unused-parameter",
        "-DLIBCACAO_SOONG_BUILD",
    ],

    target: {
        vendor: {
            exclude_shared_libs: ["libgui"],
        },
        android_arm: {
            version_script: "libcacao_client_arm.map.txt",
        },
        android_arm64: {
            version_script: "libcacao_client_arm64.map.txt",
        },
    },

    lto: {
        never: true,
    },

}

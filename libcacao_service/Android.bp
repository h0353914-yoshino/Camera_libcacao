// libcacao_service_real — CacaoService 實作
// 依照 libcacao_service.so 反編譯結果重建

cc_library_headers {
    name: "libcacao_service_headers",

    defaults: ["libcacao_common_defaults"],

    export_include_dirs: ["include"],
}

cc_library_shared {
    name: "libcacao_service",
    stem: "libcacao_service",

    defaults: ["libcacao_32bit_build_defaults"],

    // cacaoserver 與本模組在 vendor 分割區執行（vendor: true），
    // 服務以 stable AIDL（libbinder_ndk）發佈於
    // vendor.somc.cacao.ICacaoService/default，由 VINTF 片段宣告。
    vendor: true,

    srcs: [
        "src/CacaoService.cpp",
        "src/CacaoAidlServer.cpp",
    ],

    header_libs: [
        "libcacao_service_headers",
        "libcacao_client_headers",
        "libcacao_process_ctrl_gateway_headers",
        "libbase_headers",
        "libnativebase_headers",
        "libsystem_headers",
        "libcutils_headers",
    ],

    shared_libs: [
        "android.hidl.base@1.0",
        "android.hidl.manager@1.0",
        "android.hardware.camera.common@1.0",
        "android.hardware.camera.provider@2.4",
        "android.hardware.graphics.allocator@2.0",
        "libhidlbase",
        "libutils",
        "libui",
        "libbinder",
        "libbinder_ndk",
        "libnativewindow",
        "android.hardware.common-V2-ndk",
        "libcutils",
        "liblog",
        "libcacao_client",
        "libcacao_process_ctrl_gateway",
        "vendor.somc.hardware.camera.provider@1.0",
        "vendor.somc.hardware.camera.cacao@3.0",
        "vendor.somc.hardware.camera.cacao@3.1",
    ],

    static_libs: [
        "vendor.somc.cacao-V1-ndk",
        "libaidlcommonsupport",
    ],

    cflags: ["-DLIBCACAO_SOONG_BUILD"],

    version_script: "libcacao_service.map.txt",
}
